<mxfile host="drawio"><diagram name="request-flow" id="request-flow"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="사용자 질문&lt;br&gt;&quot;출근 시간 바꾸려면 언제까지 신청해요?&quot;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Malgun Gothic;fillColor=#E8F1FB;strokeColor=#4A7BB7;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="330" height="50" as="geometry"/></mxCell><mxCell id="c2" value="세션·CSRF 확인 → 실행 수락(멱등키)&lt;br&gt;SSE로 진행 단계 전송 시작" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Malgun Gothic;fillColor=#FFF4E0;strokeColor=#D08A1E;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="330" height="50" as="geometry"/></mxCell><mxCell id="c3" value="Haiku 5.5 호출&lt;br&gt;질문 + 도구 7개 스키마 + 오늘 날짜" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Malgun Gothic;fillColor=#F3ECFA;strokeColor=#7C55B0;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="330" height="50" as="geometry"/></mxCell><mxCell id="c4" value="도구를&lt;br&gt;불렀나?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Malgun Gothic;fillColor=#FFFBE6;strokeColor=#B59A1B;" vertex="1" parent="1"><mxGeometry x="135" y="245" width="140" height="80" as="geometry"/></mxCell><mxCell id="c5" value="답에 검색 약속이&lt;br&gt;있나?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Malgun Gothic;fillColor=#FFFBE6;strokeColor=#B59A1B;" vertex="1" parent="1"><mxGeometry x="420" y="245" width="170" height="80" as="geometry"/></mxCell><mxCell id="c6" value="도구를 강제해&lt;br&gt;한 번만 다시 호출" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Malgun Gothic;fillColor=#FDECEC;strokeColor=#C24848;" vertex="1" parent="1"><mxGeometry x="420" y="170" width="170" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;search_documents&lt;/b&gt;&lt;br&gt;사건 날짜 확인 · 날짜 없으면 판본별 원문" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Malgun Gothic;fillColor=#EAF6EC;strokeColor=#3F8F4F;" vertex="1" parent="1"><mxGeometry x="40" y="355" width="330" height="50" as="geometry"/></mxCell><mxCell id="c8" value="사용자 권한(ACL)으로 거른 뒤&lt;br&gt;pgvector 거리 순 후보 40개" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Malgun Gothic;fillColor=#EAF6EC;strokeColor=#3F8F4F;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="330" height="50" as="geometry"/></mxCell><mxCell id="c9" value="예산 안에 그룹 통째로 담기&lt;br&gt;첫 검색은 예산의 75%까지" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Malgun Gothic;fillColor=#EAF6EC;strokeColor=#3F8F4F;" vertex="1" parent="1"><mxGeometry x="40" y="495" width="330" height="50" as="geometry"/></mxCell><mxCell id="c10" value="영업일 기한 문장이면 마감일 미리 계산&lt;br&gt;(공휴일 반영)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Malgun Gothic;fillColor=#EAF6EC;strokeColor=#3F8F4F;" vertex="1" parent="1"><mxGeometry x="40" y="565" width="330" height="50" as="geometry"/></mxCell><mxCell id="c11" value="모델이 원문 근거로 답 작성&lt;br&gt;(필요하면 다시 검색 · 최대 6회)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Malgun Gothic;fillColor=#F3ECFA;strokeColor=#7C55B0;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="330" height="50" as="geometry"/></mxCell><mxCell id="c12" value="서버가 결과 확정&lt;br&gt;인용 ID가 실제 받은 원문인지 확인&lt;br&gt;근거 없으면 보류 · 날짜 모호하면 되묻기" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Malgun Gothic;fillColor=#FFF4E0;strokeColor=#D08A1E;" vertex="1" parent="1"><mxGeometry x="40" y="715" width="330" height="65" as="geometry"/></mxCell><mxCell id="c13" value="답 · 인용(문서·판본·쪽) · 결과 유형&lt;br&gt;메시지와 실행 기록 저장" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Malgun Gothic;fillColor=#E8F1FB;strokeColor=#4A7BB7;" vertex="1" parent="1"><mxGeometry x="40" y="805" width="330" height="50" as="geometry"/></mxCell><mxCell id="c14" value="" styl