# 키 이름과 형식 예시만 둔다. 실제 값은 같은 폴더의 .env 파일에 넣는다.
# .env는 git에서 제외되며 Claude Code는 보호 훅 때문에 .env를 읽지 않는다.

# 실행 환경
APP_ENV=local                 # local | test | production
AUTH_MODE=test_stub           # M1~M2는 test_stub(local/test에서만 허용), M3부터 local_session
TEST_ACTOR_ID=test-a          # AUTH_MODE=test_stub일 때만 사용: test-a | test-b

# DB: 개발 DB와 테스트 DB는 서로 다른 데이터베이스다(FR-08)
# 5432는 로컬 PostgreSQL 서비스, 5433·5434는 다른 프로젝트 컨테이너가 쓰고 있어 5440을 쓴다.
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5440
DATABASE_URL=postgresql+psycopg://agent:change-me-local-only@localhost:5440/agent_dev
TEST_DATABASE_URL=postgresql+psycopg://agent:change-me-local-only@localhost:5440/agent_test

# 대화 모델(D-25)
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5

# 임베딩·평가 judge(D-27). 무료 티어 입력은 Google 제품 개선에 쓰이므로 가상 문서에만 사용한다.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=1536            # 768 | 1536. M3 색인 전에 확정(O-04)
JUDGE_MODEL=                  # Gemini Flash 계열 무료 티어 모델 ID. holdout 전에 고정(O-04)

# 교육 fixture(M0~M2)
FIXTURE_MODE=fixed_status     # fixed_status | live_clock
